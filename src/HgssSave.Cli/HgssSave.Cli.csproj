<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>hgss-save</AssemblyName>
    <RootNamespace>HgssSave.Cli</RootNamespace>
    <!-- Embeds PKHeX.Core's GPL-3.0-or-later notice requirement: see README licensing section (design §2). -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HgssSave.Core\HgssSave.Core.csproj" />
    <ProjectReference Include="..\HgssSave.PKHeX\HgssSave.PKHeX.csproj" />
  </ItemGroup>

  <!-- Portable publish: `dotnet publish src/HgssSave.Cli -c Release -r win-x64` yields hgss-save.exe plus the data files below. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\registry\hgss-us.script-refs.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>hgss-us.script-refs.json</Link>
    </None>
    <None Include="..\..\registry\hgss-us.warp-spawns.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>hgss-us.warp-spawns.json</Link>
    </None>
    <None Include="..\..\registry\hgss-us.badge-rules.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>hgss-us.badge-rules.json</Link>
    </None>
    <None Include="..\..\registry\hgss-us.scene-triggers.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>hgss-us.scene-triggers.json</Link>
    </None>
    <None Include="..\..\registry\presets\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>presets\%(Filename)%(Extension)</Link>
    </None>
    <None Include="..\..\fixtures\safe-spawns.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>safe-spawns.json</Link>
    </None>
    <None Include="..\..\registry\*.symbols.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

</Project>
